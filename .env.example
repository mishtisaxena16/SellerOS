# Copy this file to `.env` (same folder) and fill in real values.
# `.env` itself is git-ignored — see ../.gitignore — so it never gets
# pushed. This file (.env.example) has no secrets in it and is safe
# to commit.

# --- Application ---
# DEBUG=True skips the production SECRET_KEY startup guard (main.py)
# so local/dev runs work without generating a real key. Leave unset
# (defaults to False) for staging/production.
# DEBUG=True

# --- JWT ---
# Required whenever DEBUG is not True — backend/main.py refuses to
# start with the default placeholder once DEBUG=False. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# --- Knowledge Engine bridge -------------------------------------------
# Only needed if the Knowledge Engine (retrieve.py/config.py/etc.) ever
# ends up somewhere engine_bridge.py's search can't find on its own —
# it currently locates ai/knowledge_layer/knowledge_engine/ automatically
# regardless of exact nesting depth. Set this only as an explicit
# override for an unusual deployment layout.
# SELLEROS_KNOWLEDGE_ENGINE_PATH=/absolute/path/to/knowledge_engine

# --- Amazon SP-API (Login with Amazon OAuth -- amazon_sdk/auth.py) -----
# App-level credentials (same for every seller) from your LWA security
# profile + Solution Provider Portal app registration. Required before
# GET /marketplaces/amazon/authorize can build an authorization URL.
# AMAZON_LWA_CLIENT_ID=
# AMAZON_LWA_CLIENT_SECRET=
# AMAZON_APP_ID=
# Must exactly match the OAuth Redirect URI registered for this app.
# AMAZON_OAUTH_REDIRECT_URI=https://your-domain.example/marketplaces/amazon/callback
#
# Per-seller refresh_token -- normally obtained per-seller through the
# Connect Amazon OAuth flow and stored encrypted in the DB, NOT set
# here. Only useful as a single-seller dev/test convenience (picked up
# by connectors_layer/session_store.py's env-var fallback) if you
# already have one refresh_token to test with, e.g. from self-
# authorizing a private application in the Solution Provider Portal.
# AMAZON_REFRESH_TOKEN=

# --- Flipkart Seller API (auto-switches connector from Playwright to API) --
# Leave all three unset/blank -> flipkart_connector uses Playwright
# (Seller Hub automation) automatically. Fill in all three once your
# API access is approved -> it switches to the real API automatically,
# on the next process restart, with no code changes needed anywhere.
# FLIPKART_CLIENT_ID=
# FLIPKART_CLIENT_SECRET=
# FLIPKART_REFRESH_TOKEN=

# --- Dev/single-seller MarketplaceSession (connectors/session_store.py) --
# Until real per-seller auth exists (backend team), this is how a
# MarketplaceSession actually gets built for local runs/testing.
# Read by connectors/session_store.py as a fallback whenever no
# session has been session_store.register()'d in memory for a given
# seller_id — good enough for one dev seller, not for production
# multi-tenant use. Amazon needs nothing here (Mock Mode connector).
# MEESHO_USERNAME=
# MEESHO_PASSWORD=
# FLIPKART_USERNAME=
# FLIPKART_PASSWORD=
